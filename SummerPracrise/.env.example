# === База данных PostgreSQL ===
DB_NAME=summer_practice
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# === Приложение ===
DEBUG=false
APP_NAME=Summer Practice — Internet Shop API

# === JWT-авторизация ===
# ВАЖНО: в реальном проекте используйте длинный случайный секрет.
JWT_SECRET=summer-practice-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# === Бизнес-правила ===
REGULAR_CUSTOMER_THRESHOLD=5000
REGULAR_CUSTOMER_DISCOUNT=0.02

# === Флаги запуска ===
# true — при старте заполнить БД тестовыми данными (через python -m app.seed)
SEED_DB=false
